# PlatformIO
.pio/
.pioenvs/
.piolibdeps/

# Generated by `pio run -e <env> -t compiledb`. Contains absolute paths to the
# local PlatformIO toolchain and WCH SDK, so it differs on every machine and
# conflicts on merge. Regenerate instead of committing -- .clangd consumes it.
compile_commands.json

# IDE
# Ignored as a whole because PlatformIO regenerates .vscode/c_cpp_properties.json
# with absolute machine-local paths on every build; committing it produces
# constant conflicts. The shared clangd setup lives in .clangd / test/.clangd.
.vscode/
.idea/
*.iml

# Tool caches (clangd index, and caches of other editors/agents)
.cache/

# Agent Manager state: worktrees are full copies of this repository nested in
# .kilo/worktrees/, which is why .clangd excludes it from the index. Machine
# local, never shared.
.kilo/

# Serena: project.yml, .gitignore and memories/ are shared on purpose --
# they are the project-level LSP configuration and the team's project notes.
# Only the local override and the LSP cache stay private; .serena/.gitignore
# already encodes that, so nothing is listed here.
#
# .serena/cache/
# .serena/project.local.yml

# Host unit tests
test/build/

# Build artifacts
*.o
*.obj
*.elf
*.hex
*.bin
*.map
*.d
*.su

# OS
.DS_Store
Thumbs.db
